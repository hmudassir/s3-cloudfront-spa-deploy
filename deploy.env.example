# Copy to deploy.env in your project root (and add deploy.env to .gitignore).

# Required
BUCKET=my-site-bucket
DIST_ID=E1ABCDEXAMPLE          # CloudFront distribution ID (starts with E), not its domain

# Optional (defaults shown)
BUILD_CMD="npm run build"
DIST_DIR=dist
BACKUP_KEEP=10
BACKUP_DIR=backups

# Folders served with Cache-Control: no-cache (content that changes without a
# new file name), space-separated. Example: FRESH_DIRS="data content"
FRESH_DIRS=

# Bucket prefixes this script must never delete or back up, because something
# else writes there (user uploads, another app). Example: PROTECTED_PREFIXES="media"
PROTECTED_PREFIXES=
